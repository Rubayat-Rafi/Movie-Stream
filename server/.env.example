PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_this_to_a_long_random_secret_in_production
JWT_EXPIRES_IN=7d

# MySQL connection string for Prisma
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/stream_movies"

# Optional: StratosPay Secret Key (leave blank to use built-in StreamHub Sandbox Checkout)
STRATOS_SECRET_API_KEY=
